{
  "include": [
    "env.d.ts",
    "src/client/**/*",
    "src/client/**/*.vue",
    "src/client/**/*.ts",
    "src/common/**/*"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "esModuleInterop": true,
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "node",
    "strict": true,
    "lib": [
      "esnext",
      "dom"
    ],
  }
}